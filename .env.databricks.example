# Copy to .env.databricks.local for local notes only. Do not commit real secrets.

# Databricks CLI profile configured with `databricks auth login --host <workspace-url>`.
DATABRICKS_PROFILE=DEFAULT

# Databricks App name used by `databricks apps create` / `databricks apps deploy`.
DATABRICKS_APP_NAME=bobabricks-store-ops-demo

# SQL warehouse backing Genie/store operations queries.
DATABRICKS_WAREHOUSE_ID=<warehouse-id>

# Optional Databricks App budget or usage policy ids for the guardrail moment.
DATABRICKS_BUDGET_POLICY_ID=<budget-policy-id>
DATABRICKS_USAGE_POLICY_ID=<usage-policy-id>

# Databricks managed Atlassian MCP connection. Store the bearer token in a
# Databricks App secret named `atlassian_mcp_bearer_token`; do not commit it.
ATLASSIAN_MCP_URL=https://fevm-worldtour-ai.cloud.databricks.com/api/2.0/mcp/external/system_ai_agent_atlassian_mcp
ATLASSIAN_MCP_BEARER_TOKEN=<store-in-databricks-app-secret>
